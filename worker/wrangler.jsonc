{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "drop-license-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "observability": { "enabled": false },
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "3001", "simple": { "limit": 12, "period": 60 } }],
  "vars": { "CREEM_MODE": "test", "CREEM_PRODUCT_ID": "REPLACE_WITH_DROP_PRODUCT_ID", "ALLOWED_EXTENSION_IDS": "REPLACE_WITH_EXTENSION_ID" }
}
