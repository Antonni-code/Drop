{
  "name": "drop-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Your useful words, one Drop away. A private local clipboard shelf.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "package": "npm run check && node scripts/package.mjs && npm run verify:package",
    "verify:package": "python3 scripts/verify-package.py",
    "verify:release": "node scripts/verify-release.mjs",
    "keys:generate": "node scripts/keys.mjs",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "test:browser": "npm run build && node scripts/test-browser.mjs"
  },
  "devDependencies": {
    "@types/chrome": "0.1.43",
    "@types/node": "22.18.6",
    "esbuild": "0.28.2",
    "sharp": "0.35.4",
    "typescript": "5.9.3",
    "vitest": "5.0.1",
    "wrangler": "4.38.0",
    "playwright": "1.63.0",
    "@axe-core/playwright": "4.13.0"
  }
}
